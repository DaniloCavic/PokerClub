# Baza
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/poker?schema=public"
# Tajni ključ za tokene sesije — OBAVEZNO promeniti u produkciji (dug, nasumičan)
JWT_SECRET="promeni-me"
JWT_EXPIRES_IN="30d"
PORT=3000
# Prvi administrator (kreira se pri pokretanju ako ne postoji)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="promeni-me-123"
# Pauza između ruku (ms) i koliko dugo igrač sme da ne igra pre nego što ustane (ms)
BETWEEN_HANDS_MS=5000
SIT_OUT_LIMIT_MS=600000
