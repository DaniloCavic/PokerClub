generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  AGENT
  ADMIN
}

enum Variant {
  HOLDEM
  OMAHA
}

enum TxType {
  DEPOSIT // agent uplatio igraču
  WITHDRAWAL // agent isplatio igraču
  BUY_IN // igrač seo za sto (žetoni sa naloga na sto)
  CASH_OUT // igrač ustao (žetoni sa stola na nalog)
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  usernameLower String    @unique
  displayName   String
  role          Role      @default(PLAYER)
  passwordHash  String
  /// Žetoni na nalogu (bez onih koji su trenutno na stolu).
  balance       Int       @default(0)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  note          String?
  /// Za agente: procenat rake-a njegovih igrača koji pripada agentu (u baznim poenima, 3000 = 30 %).
  rakeShareBps  Int       @default(0)
  /// Agent kome igrač pripada.
  agentId       String?
  agent         User?     @relation("AgentPlayers", fields: [agentId], references: [id])
  players       User[]    @relation("AgentPlayers")
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?
  /// Slika profila (mala JPEG/PNG, čuva se u bazi jer Railway nema trajni disk).
  avatar        Bytes?
  avatarType    String?
  avatarAt      DateTime?

  transactions Transaction[] @relation("TxUser")
  actions      Transaction[] @relation("TxActor")
  tables       PokerTable[]
  seats        TableSeat[]
  rakePaid     RakeShare[] @relation("RakePlayer")
  rakeEarned   RakeShare[] @relation("RakeAgent")
  liveViews    LiveViewLog[]
  notesWritten PlayerNote[] @relation("NoteOwner")
  notesAbout   PlayerNote[] @relation("NoteTarget")

  @@index([role, agentId])
}

/// Knjiga promena stanja: svaka promena balansa je jedan red, ništa se ne briše.
model Transaction {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("TxUser", fields: [userId], references: [id])
  type         TxType
  /// Promena balansa naloga: + uplata / povratak sa stola, − isplata / ulaz za sto.
  amount       Int
  balanceAfter Int
  /// Ko je izvršio uplatu ili isplatu (agent ili admin).
  actorId      String?
  actor        User?       @relation("TxActor", fields: [actorId], references: [id])
  tableId      String?
  table        PokerTable? @relation(fields: [tableId], references: [id])
  note         String?
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model PokerTable {
  id            String    @id @default(cuid())
  name          String
  variant       Variant
  smallBlind    Int
  bigBlind      Int
  minBuyIn      Int
  maxBuyIn      Int
  maxSeats      Int
  /// Rake u baznim poenima (500 = 5 %).
  rakeBps       Int       @default(0)
  /// Najviše rake-a po ruci; 0 = bez ograničenja.
  rakeCap       Int       @default(0)
  actionSeconds Int       @default(15)
  isOpen        Boolean   @default(true)
  /// Zakazano otvaranje: pre ovog trenutka igrači ne mogu da uđu za sto.
  opensAt       DateTime?
  /// Dozvoljen straddle (igrač posle velikog blajnda stavlja dva velika blajnda).
  straddle      Boolean   @default(false)
  /// Bomb pot svaka N-ta ruka (0 = bez bomb pota).
  bombPotEvery  Int       @default(0)
  /// Koliko velikih blajndova svaki igrač stavlja u bomb pot.
  bombPotBB     Int       @default(2)
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  closedAt      DateTime?

  hands        Hand[]
  seats        TableSeat[]
  transactions Transaction[]
  rakeShares   RakeShare[]
}

/// Ko sedi za stolom i sa koliko žetona (stanje posle poslednje završene ruke).
/// Ako se server ponovo pokrene, ovi žetoni se vraćaju igračima na nalog.
model TableSeat {
  tableId   String
  table     PokerTable @relation(fields: [tableId], references: [id])
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  seat      Int
  stack     Int
  updatedAt DateTime   @updatedAt

  @@id([tableId, userId])
}

model Hand {
  id        String     @id @default(cuid())
  tableId   String
  table     PokerTable @relation(fields: [tableId], references: [id])
  handNo    Int
  board     String
  pot       Int
  rake      Int
  /// Igrači, karte, dobici i tok ruke.
  details   Json
  rakeShares RakeShare[]
  /// Ko je igrao ruku (za istoriju ruku igrača).
  playerIds String[]  @default([])
  createdAt DateTime   @default(now())

  @@index([tableId, createdAt])
  @@index([createdAt])
  @@index([playerIds], type: Gin)
}

/// Deo rake-a jedne ruke koji je platio jedan igrač (srazmerno ulogu u potu)
/// i koliko od toga pripada njegovom agentu (procenat važeći u trenutku ruke).
/// Ostatak (amount − agentCut) pripada super agentu.
model RakeShare {
  id        String     @id @default(cuid())
  handId    String
  hand      Hand       @relation(fields: [handId], references: [id])
  tableId   String
  table     PokerTable @relation(fields: [tableId], references: [id])
  userId    String
  user      User       @relation("RakePlayer", fields: [userId], references: [id])
  agentId   String?
  agent     User?      @relation("RakeAgent", fields: [agentId], references: [id])
  amount    Int
  agentCut  Int
  createdAt DateTime   @default(now())

  @@index([agentId, createdAt])
  @@index([createdAt])
  @@index([userId])
}

/// Zapis svakog otvaranja "karte uživo" (super agent gleda karte svih igrača tokom ruke).
model LiveViewLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  tableId   String
  tableName String
  handNo    Int
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Beleška igrača o drugom igraču (vidi je samo onaj ko ju je napisao).
model PlayerNote {
  ownerId   String
  owner     User     @relation("NoteOwner", fields: [ownerId], references: [id])
  targetId  String
  target    User     @relation("NoteTarget", fields: [targetId], references: [id])
  text      String
  updatedAt DateTime @updatedAt

  @@id([ownerId, targetId])
}
